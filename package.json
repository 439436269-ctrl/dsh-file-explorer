{
  "name": "@vfvrpq/dsh-file-explorer",
  "version": "0.1.4",
  "description": "VS Code style folder and file explorer for DeepSeek Harness: a sidebar rail icon that opens a workspace file tree with text, Markdown and image preview.",
  "type": "module",
  "license": "MIT",
  "author": "439436269-ctrl",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "explorer",
    "file-tree",
    "preview"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/439436269-ctrl/dsh-file-explorer.git"
  },
  "homepage": "https://github.com/439436269-ctrl/dsh-file-explorer#readme",
  "bugs": {
    "url": "https://github.com/439436269-ctrl/dsh-file-explorer/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
